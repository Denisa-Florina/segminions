# Copy to .env and fill in the values. Never commit .env.

# development | production | testing
APP_ENV=development

# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Lifetime of login tokens, in minutes (default 480 = 8 hours)
# ACCESS_TOKEN_TTL_MINUTES=480

# Frontend origin allowed by CORS (no trailing slash)
FRONTEND_URL=https://medsegai.web.app

# Firebase credentials: either the full service-account JSON (one line) ...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ... or a path to the key file (defaults to backend/serviceAccountKey.json)
# FIREBASE_CREDENTIALS_PATH=

# Optional: where the nnU-Net files live (defaults to backend/ml_weights/nnunet)
# MODEL_DIR=

# The frontend's local default API URL is http://127.0.0.1:5001/api
PORT=5001
LOG_LEVEL=INFO
